{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Raylib (MSYS2)",
      "type": "shell",
      "command": "gcc",
      "args": [
        "doppler.c",
        "-o",
        "doppler.exe",
        "-I/mingw64/include",
        "-L/mingw64/lib",
        "-lraylib",
        "-lopengl32",
        "-lgdi32",
        "-lwinmm"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    }
  ]
}